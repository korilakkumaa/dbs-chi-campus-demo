# Supabase (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Import script only — never put this in Vite / frontend
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Homework ABS (Google Sheet → sync every 3 days)
# Publish sheet as CSV, or point to a local CSV for testing
# HOMEWORK_ABS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/…/export?format=csv&gid=0
# HOMEWORK_ABS_SHEET_CSV_PATH=./path/to/abs.csv
# HOMEWORK_ABS_ACADEMIC_YEAR=2026

# Outbound reminder email (Resend) — scripts + Edge Function secrets
# RESEND_API_KEY=re_…
# HOMEWORK_ABS_FROM_EMAIL=Campus CMS <reminders@your-domain.edu.hk>
